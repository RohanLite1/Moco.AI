{
  "name": "moco-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop AI HUD Assistant with 3D visuals and productivity widgets",
  "main": "backend/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:frontend\" \"npm run dev:electron\"",
    "dev:frontend": "vite --config frontend/vite.config.js frontend",
    "dev:electron": "electron backend/main.js",
    "build:frontend": "vite build --config frontend/vite.config.js frontend",
    "build:exe": "npm run build:frontend && electron-builder --win portable",
    "test:backend": "node backend/tests/test-runner.js",
    "test:backend:auto": "node backend/tests/test-runner.js --auto",
    "start": "electron backend/main.js"
  },
  "dependencies": {
    "@google/genai": "^2.29.0",
    "dotenv": "^16.4.7",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^6.0.1"
  },
  "build": {
    "appId": "com.moco.ai",
    "productName": "Moco.AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "backend/**/*",
      "shared/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
